# 릴레이(Supabase) 설정 — `.env.local` 로 복사해 채운다. `.env.local` 은 커밋되지 않는다.
#
# 개발과 운영은 **서로 다른 Supabase 프로젝트**이고, 이 파일이 읽히는 경로도 다르다:
#
#   npm run dev    → WOOI_RELAY_DEV_*   (아래 값이 개발용 빌드에 구워진다)
#   npm run build  → WOOI_RELAY_PROD_*  (CI 시크릿에서 오며, 로컬에는 보통 없다)
#
# 변수 이름이 다르기 때문에, 여기에 개발용 값을 적어 두어도 릴리즈 빌드에는 절대 섞이지 않는다.
#
# anon 키는 비밀이 아니다 — 어차피 배포 바이너리와 페어링 QR 에 실려 나간다. 접근 판정은
# 전부 Postgres RLS 가 한다. 비밀인 것은 service_role 키뿐이고, 그건 Edge Function 환경에만 있다.

WOOI_RELAY_DEV_URL=https://vicgdpqmaazavjezxkxx.supabase.co
WOOI_RELAY_DEV_ANON_KEY=

# 운영. 릴리즈를 만드는 CI 만 채운다.
# WOOI_RELAY_PROD_URL=https://hdaumqthnvplmbbytwrf.supabase.co
# WOOI_RELAY_PROD_ANON_KEY=

# 구워 넣은 값을 실행 시점에 덮어쓴다 — 로컬 `supabase start` 스택을 겨냥할 때 쓴다.
# WOOI_SUPABASE_URL=http://127.0.0.1:54321
# WOOI_SUPABASE_ANON_KEY=
