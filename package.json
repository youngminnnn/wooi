{
  "name": "wooi",
  "version": "1.23.0",
  "description": "Parallel AI coding agents across isolated git worktrees — dependent work stacks instead of conflicting, and every PR review lands on the diff",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "youngminnnn <youngmin3306@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youngminnnn/wooi.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:sandbox": "node scripts/dev-sandbox.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:renderer": "vitest run --project renderer",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "demo": "node scripts/build-demo.mjs",
    "metrics": "node scripts/adoption-snapshot.mjs",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "postinstall": "node node_modules/electron/install.js && (chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true)",
    "prepare": "husky",
    "remote:probe": "node --import ./scripts/ts-resolve.mjs scripts/remote-probe.ts",
    "relay:dev:status": "node scripts/relay.mjs development status",
    "relay:dev:migrate": "node scripts/relay.mjs development migrate",
    "relay:dev:functions": "node scripts/relay.mjs development functions",
    "relay:dev:config": "node scripts/relay.mjs development config",
    "relay:prod:status": "node scripts/relay.mjs production status",
    "relay:prod:migrate": "node scripts/relay.mjs production migrate",
    "relay:prod:functions": "node scripts/relay.mjs production functions",
    "relay:prod:config": "node scripts/relay.mjs production config",
    "remote:keystore-probe": "electron scripts/keystore-probe.mjs",
    "remote:state-probe": "electron scripts/remote-state-probe.mjs",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "test:mobile": "npm --prefix apps/mobile test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.wooi.app",
    "productName": "Wooi",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "youngminnnn",
        "repo": "wooi"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "out/main/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": "youngmin JI (9H577PWRAL)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Wooi runs coding agents and tools that may automate another app when you ask them to."
      },
      "notarize": true
    },
    "dmg": {
      "artifactName": "${productName}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@supabase/supabase-js": "^2.112.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
