<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron + node-pty 는 JIT/동적 코드 실행이 필요하므로
         hardened runtime 에서 아래 예외를 허용한다. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Wooi 가 실행한 에이전트/도구의 Apple Events 요청은 macOS 에서 Wooi 의
         요청으로 귀속된다. 이 entitlement 가 없으면 TCC 가 승인을 저장할 수 없어
         같은 대상 앱에 대한 요청이 반복될 수 있다. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- node-pty spawn-helper 등 자식 프로세스 실행 허용 -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
